// AudioNest Database Schema
// Premium Audio Content Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String?
  avatarUrl     String?
  phone         String?

  // Subscription
  subscription          SubscriptionTier @default(FREE)
  subscriptionExpiresAt DateTime?
  subscriptionPlatform  String?

  // Coins
  coins         Int       @default(0)

  // Listening Stats
  totalListenTime       Int @default(0) // in minutes
  totalEpisodesCompleted Int @default(0)
  currentStreak         Int @default(0)
  longestStreak         Int @default(0)
  lastListenDate        DateTime?

  // Preferences
  preferences   Json      @default("{}")

  // Timestamps
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  subscriptions       Subscription[]
  listeningHistory    ListeningHistory[]
  librarySubscriptions LibrarySubscription[]
  libraryLikes        LibraryLike[]
  playlists           Playlist[]
  downloads           Download[]
  coinTransactions    CoinTransaction[]
  purchases           Purchase[]
  creator             Creator?
  comments            Comment[]
  reviews             Review[]
  achievements        UserAchievement[]
  notifications       Notification[]
  giftsSent           LiveGiftTransaction[] @relation("GiftSender")

  // Gamification relations
  badges              UserBadge[]
  userLevel           UserLevel?
  challenges          UserChallenge[]
  leaderboardEntries  LeaderboardEntry[]

  // Credit relations
  userCredits         UserCredit?
  creditTransactions  CreditTransaction[]

  // Social relations
  followers           UserFollow[] @relation("UserFollowing")
  following           UserFollow[] @relation("UserFollowers")
  playlistCollaborations PlaylistCollaborator[]
  playlistFollows     PlaylistFollower[]
  ownedClubs          AudioClub[] @relation("ClubOwner")
  clubMemberships     ClubMember[]
  activities          UserActivity[]
  activityLikes       ActivityLike[]
  activityComments    ActivityComment[]

  // Family & Gift relations
  familyPlanOwned     FamilyPlan? @relation("FamilyPlanOwner")
  familyMembership    FamilyMember?
  giftsSentSub        GiftSubscription[] @relation("GiftsSent")
  giftsReceivedSub    GiftSubscription[] @relation("GiftsReceived")

  // Notification relations
  notificationPreference NotificationPreference?
  devices                UserDevice[]

  // Admin relations
  auditLogs              AuditLog[]

  // OAuth accounts
  accounts      Account[]
  sessions      Session[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum SubscriptionTier {
  FREE
  VIP
  SVIP
}

// ============================================
// Subscription & Payments
// ============================================

model Subscription {
  id        String   @id @default(cuid())
  userId    String

  tier      SubscriptionTier
  status    SubscriptionStatus @default(ACTIVE)

  // Payment
  platform  PaymentPlatform
  planType  PlanType
  amount    Int
  currency  String   @default("KRW")

  // Period
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?

  // External IDs
  externalSubscriptionId String?
  externalCustomerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAUSED
}

enum PaymentPlatform {
  TOSS
  STRIPE
  APPLE
  GOOGLE
}

enum PlanType {
  MONTHLY
  YEARLY
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String

  type      CoinTransactionType
  amount    Int      // positive for credit, negative for debit
  balance   Int      // balance after transaction

  // Reference
  referenceType String?
  referenceId   String?
  description   String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coin_transactions")
}

enum CoinTransactionType {
  PURCHASE
  SUBSCRIPTION_BONUS
  ACHIEVEMENT
  GIFT_SENT
  GIFT_RECEIVED
  CONTENT_PURCHASE
  REFUND
  STREAK_BONUS
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String

  // Item
  itemType  PurchaseItemType
  itemId    String

  // Payment
  amount    Int
  currency  String   @default("KRW")
  coinAmount Int?

  status    PurchaseStatus @default(COMPLETED)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemType, itemId])
  @@map("purchases")
}

enum PurchaseItemType {
  ALBUM
  EPISODE
  COIN_PACKAGE
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================
// Content - Albums & Episodes
// ============================================

model Album {
  id          String   @id @default(cuid())

  // Basic Info
  title       String
  subtitle    String?
  description String?  @db.Text
  coverUrl    String?

  // Classification
  category    Category
  subcategory String?
  tags        String[]

  // Creator
  creatorId   String
  narratorId  String?

  // Content Info
  contentType ContentType @default(AUDIOBOOK)
  totalEpisodes Int       @default(0)
  totalDuration Int       @default(0) // in seconds

  // Access Control
  accessType  AccessType  @default(FREEMIUM)
  price       Int?
  coinPrice   Int?

  // Statistics
  playCount       BigInt  @default(0)
  subscriberCount Int     @default(0)
  likeCount       Int     @default(0)
  rating          Float   @default(0)
  ratingCount     Int     @default(0)

  // Status
  status          AlbumStatus @default(ONGOING)
  updateFrequency String?
  lastEpisodeAt   DateTime?

  // Book Info (for audiobooks)
  bookInfo    Json?

  // Flags
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)
  isExclusive Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  creator     Creator   @relation("AlbumCreator", fields: [creatorId], references: [id])
  narrator    Creator?  @relation("AlbumNarrator", fields: [narratorId], references: [id])
  episodes    Episode[]
  librarySubscriptions LibrarySubscription[]
  libraryLikes LibraryLike[]
  reviews     Review[]

  @@index([category])
  @@index([creatorId])
  @@index([isFeatured, playCount(sort: Desc)])
  @@index([isPublished, createdAt(sort: Desc)])
  @@map("albums")
}

enum Category {
  AUDIOBOOK_FICTION
  AUDIOBOOK_NONFICTION
  AUDIOBOOK_SELFHELP
  AUDIOBOOK_BUSINESS
  PODCAST_TALK
  PODCAST_COMEDY
  PODCAST_NEWS
  PODCAST_TRUE_CRIME
  COURSE_LANGUAGE
  COURSE_SKILL
  KIDS
  ASMR
  SLEEP
  MUSIC
}

enum ContentType {
  AUDIOBOOK
  PODCAST
  COURSE
  ASMR
  MUSIC
  RADIO
}

enum AccessType {
  FREE
  FREEMIUM
  VIP
  PAID
}

enum AlbumStatus {
  ONGOING
  COMPLETED
  HIATUS
}

model Episode {
  id        String   @id @default(cuid())
  albumId   String

  // Basic Info
  number    Int
  title     String
  description String? @db.Text

  // Audio
  audioUrl  String
  duration  Int      // in seconds
  fileSize  BigInt?
  waveformData Json?

  // Access Control
  accessType EpisodeAccessType @default(VIP)
  previewDuration Int?

  // Chapters
  chapters  Json?

  // Statistics
  playCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  album         Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  listeningHistory ListeningHistory[]
  libraryLikes  LibraryLike[]
  playlistEpisodes PlaylistEpisode[]
  downloads     Download[]
  comments      Comment[]

  @@unique([albumId, number])
  @@index([albumId, number])
  @@map("episodes")
}

enum EpisodeAccessType {
  FREE
  VIP
  PAID
  PREVIEW
}

// ============================================
// Creator
// ============================================

model Creator {
  id        String   @id @default(cuid())
  userId    String   @unique

  // Profile
  name          String
  displayName   String?
  bio           String?  @db.Text
  avatarUrl     String?
  coverImageUrl String?

  // Verification
  isVerified    Boolean  @default(false)
  verifiedAt    DateTime?

  // Type
  type          CreatorType @default(INDIVIDUAL)

  // Statistics
  totalAlbums     Int     @default(0)
  totalEpisodes   Int     @default(0)
  totalPlayCount  BigInt  @default(0)
  followerCount   Int     @default(0)

  // Revenue
  totalRevenue    Decimal @default(0) @db.Decimal(12, 2)
  pendingRevenue  Decimal @default(0) @db.Decimal(12, 2)
  revenueShareRate Decimal @default(0.5) @db.Decimal(3, 2)

  // Social Links
  links         Json?

  // Payment Info
  paymentInfo   Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumsCreated Album[] @relation("AlbumCreator")
  albumsNarrated Album[] @relation("AlbumNarrator")
  followers     CreatorFollow[]
  liveRooms     LiveRoom[]
  revenues      CreatorRevenue[]
  giftsReceived LiveGiftTransaction[]

  @@index([isVerified])
  @@map("creators")
}

enum CreatorType {
  INDIVIDUAL
  STUDIO
  PUBLISHER
  BRAND
}

model CreatorFollow {
  id        String   @id @default(cuid())
  creatorId String
  userId    String

  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, userId])
  @@map("creator_follows")
}

model CreatorRevenue {
  id        String   @id @default(cuid())
  creatorId String

  // Period
  period    String   // "2024-01"

  // Revenue Details
  subscriptionShare Decimal @default(0) @db.Decimal(12, 2)
  directSales       Decimal @default(0) @db.Decimal(12, 2)
  adRevenue         Decimal @default(0) @db.Decimal(12, 2)
  tipsReceived      Decimal @default(0) @db.Decimal(12, 2)

  totalGross   Decimal @default(0) @db.Decimal(12, 2)
  platformFee  Decimal @default(0) @db.Decimal(12, 2)
  netRevenue   Decimal @default(0) @db.Decimal(12, 2)

  // Settlement
  status       RevenueStatus @default(PENDING)
  paidAt       DateTime?
  paymentMethod String?

  createdAt    DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, period])
  @@map("creator_revenues")
}

enum RevenueStatus {
  PENDING
  PROCESSING
  PAID
}

// ============================================
// Library & Listening
// ============================================

model ListeningHistory {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  albumId   String

  // Playback
  position  Int      @default(0) // in seconds
  duration  Int
  progress  Float    @default(0) // 0-100
  completed Boolean  @default(false)

  // Statistics
  totalListenTime Int @default(0) // total time spent on this episode
  listenCount     Int @default(1)

  lastPlayedAt  DateTime @default(now())
  firstPlayedAt DateTime @default(now())

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, lastPlayedAt(sort: Desc)])
  @@map("listening_history")
}

model LibrarySubscription {
  id        String   @id @default(cuid())
  userId    String
  albumId   String

  notificationEnabled Boolean @default(true)
  subscribedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@map("library_subscriptions")
}

model LibraryLike {
  id        String   @id @default(cuid())
  userId    String

  targetType LikeTargetType
  targetId   String

  likedAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album?   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@map("library_likes")
}

enum LikeTargetType {
  ALBUM
  EPISODE
}

model Playlist {
  id        String   @id @default(cuid())
  userId    String

  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean @default(false)
  visibility  String  @default("PRIVATE") // PRIVATE, FRIENDS, PUBLIC

  // Collaboration
  allowCollaborators Boolean @default(false)

  totalDuration Int @default(0)
  followerCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes      PlaylistEpisode[]
  collaborators PlaylistCollaborator[]
  followers     PlaylistFollower[]

  @@index([userId])
  @@index([isPublic, followerCount(sort: Desc)])
  @@map("playlists")
}

model PlaylistEpisode {
  id         String   @id @default(cuid())
  playlistId String
  episodeId  String

  sortOrder  Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  episode  Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([playlistId, episodeId])
  @@map("playlist_episodes")
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  albumId   String

  // Status
  status    DownloadStatus @default(PENDING)
  progress  Int            @default(0)

  // File Info
  fileSize  BigInt?
  quality   AudioQuality @default(MEDIUM)

  // Expiration
  expiresAt      DateTime
  lastVerifiedAt DateTime @default(now())

  downloadedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, status])
  @@map("downloads")
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  COMPLETED
  FAILED
  EXPIRED
}

enum AudioQuality {
  LOW
  MEDIUM
  HIGH
}

// ============================================
// Live Streaming
// ============================================

model LiveRoom {
  id        String   @id @default(cuid())
  hostId    String

  // Info
  title       String
  description String?
  coverUrl    String?
  category    Category?
  tags        String[]

  // Status
  status      LiveStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  // Participants
  currentListeners    Int @default(0)
  peakListeners       Int @default(0)
  totalUniqueListeners Int @default(0)

  // Revenue
  totalGiftsReceived Int @default(0)

  // Recording
  isRecorded   Boolean @default(false)
  recordingUrl String?

  createdAt DateTime @default(now())

  host Creator @relation(fields: [hostId], references: [id])
  gifts LiveGiftTransaction[]

  @@index([status, scheduledAt])
  @@map("live_rooms")
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

model LiveGift {
  id        String   @id @default(cuid())

  name      String
  icon      String
  animation String?
  coinCost  Int
  hostReceives Int

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("live_gifts")
}

model LiveGiftTransaction {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  hostId    String

  giftId    String
  quantity  Int      @default(1)
  totalCoins Int
  hostReceived Int

  message   String?

  createdAt DateTime @default(now())

  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("GiftSender", fields: [senderId], references: [id])
  host   Creator  @relation(fields: [hostId], references: [id])

  @@index([roomId])
  @@map("live_gift_transactions")
}

// ============================================
// Comments & Reviews
// ============================================

model Comment {
  id        String   @id @default(cuid())
  userId    String
  episodeId String

  content   String   @db.Text

  likeCount Int      @default(0)

  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([episodeId])
  @@map("comments")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  albumId   String

  rating    Int      // 1-5
  title     String?
  content   String?  @db.Text

  likeCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([albumId])
  @@map("reviews")
}

// ============================================
// Achievements & Gamification
// ============================================

model Achievement {
  id          String   @id @default(cuid())

  name        String
  description String
  icon        String

  type        AchievementType
  requirement Int      // e.g., 100 for "100 hours listened"

  coinReward  Int      @default(0)

  isActive    Boolean  @default(true)

  userAchievements UserAchievement[]

  @@map("achievements")
}

enum AchievementType {
  LISTEN_TIME
  EPISODES_COMPLETED
  STREAK
  BOOKS_COMPLETED
  GENRES_EXPLORED
  SOCIAL
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String

  progress      Int      @default(0)
  completed     Boolean  @default(false)
  completedAt   DateTime?

  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ============================================
// Advanced Gamification - Badges
// ============================================

model Badge {
  id          String   @id @default(cuid())

  name        String
  description String
  icon        String
  category    BadgeCategory

  // Rarity affects display and rewards
  rarity      BadgeRarity @default(COMMON)

  // Earning conditions
  condition   Json     // { type: "listen_time", value: 100 }

  // Rewards
  coinReward  Int      @default(0)
  xpReward    Int      @default(0)

  // Display
  isHidden    Boolean  @default(false) // Hidden until earned
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())

  userBadges  UserBadge[]

  @@index([category, isActive])
  @@map("badges")
}

enum BadgeCategory {
  LISTENING     // 청취 관련
  COLLECTION    // 컬렉션/라이브러리
  SOCIAL        // 소셜 활동
  ACHIEVEMENT   // 특별 업적
  EVENT         // 이벤트/시즌 한정
  CREATOR       // 크리에이터 관련
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String

  earnedAt  DateTime @default(now())

  // Optional metadata
  metadata  Json?    // Additional context about earning

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId, earnedAt(sort: Desc)])
  @@map("user_badges")
}

// ============================================
// User Levels & Experience
// ============================================

model UserLevel {
  id        String   @id @default(cuid())
  userId    String   @unique

  level     Int      @default(1)
  xp        Int      @default(0)
  xpToNext  Int      @default(100)

  // Titles earned at certain levels
  title     String?

  // Statistics
  totalXpEarned Int  @default(0)
  levelUps      Int  @default(0)

  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_levels")
}

model LevelTier {
  id          String   @id @default(cuid())

  level       Int      @unique
  xpRequired  Int
  title       String?

  // Benefits at this level
  benefits    Json?    // { downloadLimit: 50, skipAds: true }

  // Visual
  icon        String?
  frameColor  String?

  @@map("level_tiers")
}

// ============================================
// Challenges & Missions
// ============================================

model Challenge {
  id          String   @id @default(cuid())

  title       String
  description String
  icon        String?

  type        ChallengeType
  category    Category?

  // Conditions
  conditions  Json     // { type: "listen_minutes", value: 60, category: "AUDIOBOOK_FICTION" }

  // Rewards
  coinReward  Int      @default(0)
  xpReward    Int      @default(0)
  badgeId     String?  // Optional badge reward

  // Duration
  duration    ChallengeDuration
  startsAt    DateTime?
  endsAt      DateTime?

  // Limits
  maxParticipants Int?

  isActive    Boolean  @default(true)
  isHidden    Boolean  @default(false)

  createdAt   DateTime @default(now())

  userChallenges UserChallenge[]

  @@index([type, isActive])
  @@index([startsAt, endsAt])
  @@map("challenges")
}

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  SPECIAL   // 이벤트 챌린지
  SEASONAL  // 시즌 챌린지
}

enum ChallengeDuration {
  ONE_DAY
  THREE_DAYS
  ONE_WEEK
  TWO_WEEKS
  ONE_MONTH
  CUSTOM
}

model UserChallenge {
  id          String   @id @default(cuid())
  userId      String
  challengeId String

  status      UserChallengeStatus @default(ACTIVE)
  progress    Int      @default(0)
  target      Int      // Copied from challenge at join time

  joinedAt    DateTime @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("user_challenges")
}

enum UserChallengeStatus {
  ACTIVE
  COMPLETED
  FAILED
  EXPIRED
}

// ============================================
// Leaderboards
// ============================================

model Leaderboard {
  id          String   @id @default(cuid())

  name        String
  description String?

  type        LeaderboardType
  scope       LeaderboardScope
  category    Category?

  // Reset period
  resetPeriod LeaderboardPeriod
  lastResetAt DateTime @default(now())
  nextResetAt DateTime

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())

  entries     LeaderboardEntry[]

  @@index([type, scope, isActive])
  @@map("leaderboards")
}

enum LeaderboardType {
  LISTEN_TIME
  EPISODES_COMPLETED
  STREAK
  XP_EARNED
  GIFTS_SENT
  REVIEWS_WRITTEN
}

enum LeaderboardScope {
  GLOBAL
  FRIENDS
  CATEGORY
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

model LeaderboardEntry {
  id            String   @id @default(cuid())
  leaderboardId String
  userId        String

  score         BigInt   @default(0)
  rank          Int?
  previousRank  Int?

  // Period tracking
  periodStart   DateTime
  periodEnd     DateTime

  updatedAt     DateTime @updatedAt

  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, userId, periodStart])
  @@index([leaderboardId, score(sort: Desc)])
  @@index([userId])
  @@map("leaderboard_entries")
}

// ============================================
// Credits System (for content purchases)
// ============================================

model CreditPackage {
  id          String   @id @default(cuid())

  name        String
  description String?

  credits     Int      // Number of credits
  price       Int      // Price in KRW
  currency    String   @default("KRW")

  // Bonus
  bonusCredits Int     @default(0)

  // Display
  isPopular   Boolean  @default(false)
  isBestValue Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())

  @@map("credit_packages")
}

model UserCredit {
  id          String   @id @default(cuid())
  userId      String   @unique

  balance     Int      @default(0)
  bonusBalance Int     @default(0)  // Bonus credits (used first)

  totalPurchased Int   @default(0)
  totalSpent     Int   @default(0)

  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credits")
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String

  type        CreditTransactionType
  amount      Int      // Positive for credit, negative for debit
  balance     Int      // Balance after transaction
  isBonus     Boolean  @default(false)

  // Reference
  referenceType String?
  referenceId   String?
  description   String?

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_transactions")
}

enum CreditTransactionType {
  PURCHASE
  SUBSCRIPTION_BONUS
  CONTENT_PURCHASE
  REFUND
  GIFT
  PROMOTION
  EXPIRED
}

// ============================================
// Notifications
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String

  type      NotificationType
  title     String
  body      String
  imageUrl  String?
  data      Json?

  read      Boolean  @default(false)
  readAt    DateTime?
  priority  NotificationPriority @default(NORMAL)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  // Content notifications
  NEW_EPISODE
  NEW_ALBUM
  CONTENT_RECOMMENDATION

  // Social notifications
  NEW_FOLLOWER
  PLAYLIST_INVITE
  CLUB_INVITE
  CLUB_MEETING
  ACTIVITY_LIKE
  ACTIVITY_COMMENT

  // Creator notifications
  TIP_RECEIVED
  PAYOUT_PROCESSED
  MILESTONE_REACHED

  // System notifications
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_RENEWED
  FAMILY_INVITE
  GIFT_RECEIVED
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
  LIVE_STARTED

  // Promotional
  PROMOTION
  ANNOUNCEMENT
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique

  pushEnabled   Boolean @default(true)
  emailEnabled  Boolean @default(true)
  inAppEnabled  Boolean @default(true)

  quietHoursStart Int?  // 0-23
  quietHoursEnd   Int?  // 0-23

  // Per-type settings stored as JSON
  typeSettings Json?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model UserDevice {
  id        String   @id @default(cuid())
  userId    String

  pushToken String
  platform  String   // android, ios, web

  deviceName  String?
  deviceModel String?

  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([pushToken])
  @@map("user_devices")
}

// ============================================
// Search & Analytics
// ============================================

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?

  query     String
  resultCount Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("search_history")
}

model PlaybackSync {
  id        String   @id @default(cuid())
  userId    String   @unique

  // Current Playback
  currentEpisodeId String?
  currentPosition  Int?
  deviceId         String?

  // Queue
  queue     Json?

  // Settings
  settings  Json?

  updatedAt DateTime @updatedAt

  @@map("playback_sync")
}

// ============================================
// Social - User Following
// ============================================

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String

  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

// ============================================
// Social - Playlist Collaboration
// ============================================

model PlaylistCollaborator {
  id         String   @id @default(cuid())
  playlistId String
  userId     String

  canEdit    Boolean  @default(false)
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@map("playlist_collaborators")
}

model PlaylistFollower {
  id         String   @id @default(cuid())
  playlistId String
  userId     String

  followedAt DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@map("playlist_followers")
}

// ============================================
// Social - Audio Clubs
// ============================================

model AudioClub {
  id          String   @id @default(cuid())
  ownerId     String

  name        String
  description String   @db.Text
  coverUrl    String?

  type        ClubType
  category    String?
  tags        String[]

  maxMembers      Int     @default(50)
  requireApproval Boolean @default(false)

  // Current reading/listening
  currentContentId   String?
  currentContentType String?

  memberCount Int @default(0)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User @relation("ClubOwner", fields: [ownerId], references: [id])
  members     ClubMember[]
  meetings    ClubMeeting[]
  discussions ClubDiscussion[]

  @@index([type, isActive])
  @@map("audio_clubs")
}

enum ClubType {
  BOOK_CLUB
  PODCAST_CLUB
  LISTENING_PARTY
  STUDY_GROUP
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String

  role      ClubMemberRole @default(MEMBER)

  // Progress tracking
  listenProgress Float @default(0)

  joinedAt  DateTime @default(now())

  club      AudioClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_members")
}

enum ClubMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model ClubMeeting {
  id          String   @id @default(cuid())
  clubId      String

  topic       String
  description String?  @db.Text

  scheduledAt DateTime
  contentId   String?
  contentType String?

  createdAt   DateTime @default(now())

  club        AudioClub @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, scheduledAt])
  @@map("club_meetings")
}

model ClubDiscussion {
  id        String   @id @default(cuid())
  clubId    String
  userId    String

  content   String   @db.Text
  parentId  String?

  likeCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club      AudioClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  parent    ClubDiscussion? @relation("DiscussionReplies", fields: [parentId], references: [id])
  replies   ClubDiscussion[] @relation("DiscussionReplies")

  @@index([clubId, createdAt(sort: Desc)])
  @@map("club_discussions")
}

// ============================================
// Social - Activity Feed
// ============================================

model UserActivity {
  id        String   @id @default(cuid())
  userId    String

  type      ActivityType

  // Target content
  targetType String?
  targetId   String?
  targetTitle String?
  targetCoverUrl String?

  // Additional data
  metadata  Json?

  // Engagement
  likeCount    Int @default(0)
  commentCount Int @default(0)

  // Visibility
  isPublic  Boolean @default(true)

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     ActivityLike[]
  comments  ActivityComment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("user_activities")
}

enum ActivityType {
  STARTED_LISTENING
  FINISHED_EPISODE
  FINISHED_ALBUM
  WROTE_REVIEW
  EARNED_BADGE
  JOINED_CLUB
  CREATED_PLAYLIST
  FOLLOWED_CREATOR
  STREAK_MILESTONE
  LEVEL_UP
}

model ActivityLike {
  id         String   @id @default(cuid())
  activityId String
  userId     String

  createdAt  DateTime @default(now())

  activity   UserActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@map("activity_likes")
}

model ActivityComment {
  id         String   @id @default(cuid())
  activityId String
  userId     String

  content    String   @db.Text

  createdAt  DateTime @default(now())

  activity   UserActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
  @@map("activity_comments")
}

// ============================================
// Family Plan & Gift Subscriptions
// ============================================

model FamilyPlan {
  id          String   @id @default(cuid())
  ownerId     String   @unique

  maxMembers  Int      @default(6)
  memberCount Int      @default(1)

  status      FamilyPlanStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User @relation("FamilyPlanOwner", fields: [ownerId], references: [id])
  members     FamilyMember[]

  @@map("family_plans")
}

enum FamilyPlanStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model FamilyMember {
  id           String   @id @default(cuid())
  familyPlanId String
  userId       String   @unique

  invitedAt    DateTime @default(now())
  acceptedAt   DateTime?

  status       FamilyMemberStatus @default(PENDING)

  familyPlan   FamilyPlan @relation(fields: [familyPlanId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyPlanId])
  @@map("family_members")
}

enum FamilyMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

model GiftSubscription {
  id          String   @id @default(cuid())
  senderId    String
  recipientEmail String

  tier        SubscriptionTier
  duration    Int      // in months

  // Gift details
  message     String?  @db.Text
  senderName  String

  // Payment
  amount      Int
  currency    String   @default("KRW")

  // Redemption
  code        String   @unique
  redeemedBy  String?
  redeemedAt  DateTime?

  expiresAt   DateTime
  createdAt   DateTime @default(now())

  sender      User     @relation("GiftsSent", fields: [senderId], references: [id])
  recipient   User?    @relation("GiftsReceived", fields: [redeemedBy], references: [id])

  @@index([code])
  @@index([senderId])
  @@map("gift_subscriptions")
}

// ============================================
// Admin & Audit
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String

  action      String   // UPDATE_USER, DELETE_ALBUM, VERIFY_CREATOR, etc.
  targetType  String   // user, album, creator, system
  targetId    String

  details     Json?

  ipAddress   String

  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
