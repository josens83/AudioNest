# ===========================================
# AudioNest - Environment Variables
# ===========================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/audionest"
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRATION="7d"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Payment - Toss Payments
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# Payment - Stripe
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Apple IAP
APPLE_SHARED_SECRET=""

# Google Play Billing
GOOGLE_SERVICE_ACCOUNT_KEY=""

# Storage - Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="audionest-audio"
R2_PUBLIC_URL=""

# CDN
CDN_URL=""

# Search - Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# AI Services
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
ANTHROPIC_API_KEY=""

# Push Notifications
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Analytics
MIXPANEL_TOKEN=""
AMPLITUDE_API_KEY=""

# Live Streaming - Agora
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@audionest.com"

# App URLs
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# Environment
NODE_ENV="development"
